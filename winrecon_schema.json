{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WinRecon Security Audit Report",
  "description": "JSON output schema for WinRecon v4.1.0 security audit reports.",
  "type": "object",
  "required": ["tool", "version", "author", "system_info", "score", "findings"],
  "properties": {
    "tool": {
      "type": "string",
      "const": "WinRecon"
    },
    "version": {
      "type": "string",
      "description": "WinRecon version that generated the report."
    },
    "author": {
      "type": "string"
    },
    "system_info": {
      "type": "object",
      "required": ["hostname", "os", "os_version", "architecture", "current_user", "is_admin", "python_version", "scan_time"],
      "properties": {
        "hostname": { "type": "string" },
        "os": { "type": "string" },
        "os_version": { "type": "string" },
        "architecture": { "type": "string" },
        "processor": { "type": "string" },
        "current_user": { "type": "string" },
        "is_admin": { "type": "boolean" },
        "python_version": { "type": "string" },
        "scan_time": { "type": "string", "format": "date-time" },
        "domain": { "type": "string" },
        "ip_addresses": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "score": {
      "type": "object",
      "required": ["score", "grade", "critical", "warning", "pass", "info", "total_findings"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "grade": { "type": "string", "enum": ["A", "B", "C", "D", "F"] },
        "critical": { "type": "integer", "minimum": 0 },
        "warning": { "type": "integer", "minimum": 0 },
        "pass": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 },
        "total_findings": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "category", "title", "severity", "description"],
        "properties": {
          "check_id": { "type": "string", "pattern": "^[A-Z]{2,4}-\\d{3,4}$" },
          "category": { "type": "string" },
          "title": { "type": "string" },
          "severity": { "type": "string", "enum": ["CRITICAL", "WARNING", "INFO", "PASS"] },
          "description": { "type": "string" },
          "detail": { "type": "string" },
          "remediation": { "type": "string" }
        }
      }
    }
  }
}
